{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A registered member of the organization.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "faydaId": { "type": "string", "description": "Ethiopian Digital ID" },
        "faydaVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "membershipType": { "type": "string" },
        "customAttributes": { "type": "object", "description": "Dynamic custom attributes" },
        "createdAt": { "type": "string", "format": "date-time" },
        "otpVerified": { "type": "boolean" }
      },
      "required": ["uid", "fullName", "email", "phoneNumber"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record for membership fees.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["ETB"] },
        "method": { "type": "string", "enum": ["telebirr", "manual"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "transactionId": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "confirmedBy": { "type": "string", "description": "Admin UID who confirmed manual payment" }
      },
      "required": ["memberId", "amount", "method", "status"]
    },
    "OrganizationConfig": {
      "title": "Organization Config",
      "description": "Settings for the organization including custom attributes.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "customAttributeDefinitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string", "enum": ["text", "number", "date", "select"] },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Member profiles"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records"
    },
    "/config/org": {
      "schema": "OrganizationConfig",
      "description": "Organization settings"
    }
  }
}
